# PORT Server lokal (default: 5000)
PORT=5000

# Secret Key untuk JSON Web Token (JWT)
JWT_SECRET=rumah_bunda_lms_super_secret_key_2025

# SUPABASE DATABASE URL (Connection String / URI)
# Dapatkan dari Supabase Dashboard:
# Project Settings -> Database -> Connection String -> URI (atau Node.js / Transaction Pooler port 6543)
# Contoh:
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
